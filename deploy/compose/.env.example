# Copy to .env and edit. Never commit .env.
POSTGRES_PASSWORD=change-me
AICP_INGEST_TOKEN=change-me-long-random-string
AICP_ORG_NAME=Example DIB Co

# Microsoft 365 collector (Entra app registration with application permissions:
# AuditLog.Read.All, Directory.Read.All, SecurityAlert.Read.All, AiEnterpriseInteraction.Read.All)
AICP_M365_TENANT_ID=
AICP_M365_CLIENT_ID=
AICP_M365_CLIENT_SECRET=

# Gateway. monitor = record only; enforce = block/mask per policy.
AICP_GW_MODE=monitor
# Real provider. Examples:
#   https://api.openai.com                                   (OpenAI)
#   https://<resource>.openai.azure.com/openai/deployments/<deployment>   (Azure OpenAI; add ?api-version=... handling in 0.3)
#   http://litellm:4000                                       (LiteLLM proxy -> Bedrock etc.)
#   http://vllm:8000                                          (on-prem)
AICP_GW_UPSTREAM_URL=http://mock-model:9999
AICP_GW_UPSTREAM_KEY=
# On-prem model allowed to receive CUI (enables the route_local policy action). Optional.
AICP_GW_LOCAL_UPSTREAM_URL=
