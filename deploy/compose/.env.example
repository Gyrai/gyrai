# Copy to .env and edit. Never commit .env.
POSTGRES_PASSWORD=change-me
AICP_INGEST_TOKEN=change-me-long-random-string
AICP_ORG_NAME=Example DIB Co

# Console login. Leave AICP_ADMIN_PASSWORD blank to have one generated and printed once in
# `docker compose logs api` (you will be made to change it at first login). Set SESSION_SECRET
# to a long random string so logins survive restarts. COOKIE_SECURE=true once behind TLS.
AICP_ADMIN_PASSWORD=
AICP_SESSION_SECRET=
AICP_COOKIE_SECURE=false

# Microsoft 365 collector (Entra app registration with application permissions:
# AuditLog.Read.All, Directory.Read.All, SecurityAlert.Read.All, AiEnterpriseInteraction.Read.All)
AICP_M365_TENANT_ID=
AICP_M365_CLIENT_ID=
AICP_M365_CLIENT_SECRET=

# Gateway. monitor = record only; enforce = block/mask per policy.
AICP_GW_MODE=monitor
# Real provider. Examples:
#   https://api.openai.com                                   (OpenAI)
#   https://<resource>.openai.azure.com/openai/deployments/<deployment>   (Azure OpenAI; add ?api-version=... handling in 0.3)
#   http://litellm:4000                                       (LiteLLM proxy -> Bedrock etc.)
#   http://vllm:8000                                          (on-prem)
AICP_GW_UPSTREAM_URL=http://mock-model:9999
AICP_GW_UPSTREAM_KEY=
# On-prem model allowed to receive CUI (enables the route_local policy action). Optional.
AICP_GW_LOCAL_UPSTREAM_URL=

# SIEM forwarder. Comma-separated outputs: file, splunk_hec, sentinel, syslog_cef
AICP_FWD_OUTPUTS=file
AICP_FWD_POLL_SECONDS=10
# splunk_hec
AICP_FWD_SPLUNK_URL=
AICP_FWD_SPLUNK_TOKEN=
AICP_FWD_SPLUNK_INDEX=
# sentinel (Logs Ingestion API: DCE + DCR + Entra app with Monitoring Metrics Publisher)
AICP_FWD_SENTINEL_DCE_URL=
AICP_FWD_SENTINEL_DCR_ID=
AICP_FWD_SENTINEL_TENANT_ID=
AICP_FWD_SENTINEL_CLIENT_ID=
AICP_FWD_SENTINEL_CLIENT_SECRET=
# syslog_cef (QRadar, ArcSight, Elastic, Graylog, rsyslog)
AICP_FWD_SYSLOG_HOST=
AICP_FWD_SYSLOG_PORT=514
AICP_FWD_SYSLOG_PROTOCOL=tcp
